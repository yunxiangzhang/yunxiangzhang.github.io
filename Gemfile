# Local preview environment matching GitHub Pages (Jekyll 3 + whitelisted plugins).
source "https://rubygems.org"

gem "github-pages", ">= 232", group: :jekyll_plugins

# Standard-library gems that newer Rubies no longer bundle by default, but
# that Jekyll 3 still needs.
gem "webrick"
gem "csv"
gem "base64"
gem "bigdecimal"
gem "logger"
gem "ostruct"
